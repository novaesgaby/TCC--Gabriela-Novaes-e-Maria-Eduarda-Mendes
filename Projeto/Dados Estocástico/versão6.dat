# =============================================================================================================
# SEÇÃO DE DADOS (DATA) - MODELO PBIO (VERSÃO 6) - Modelo Estocástico
# =============================================================================================================

data;

# Conjuntos
set T := 2024 2025;                                      # Horizonte de planejamento
set P := polo_norteMG polo_semiarido;
set R := rede_catadores_moc rede_urbana;
set M := Soja Algodao Macauba Girassol Nabo_Forrageiro;
set S := S1 S2 S3;                                       # Conjunto de cenários

# Probabilidade de cada cenário ocorrer (pi_omega)
param pi :=
    S1  0.2
    S2  0.5
    S3  0.3;

# Parâmetros de rendimento e perdas de cada matéria-prima (m)
# Indica o teor de óleo. Ex: soja tem 18% de conversão de óleo
param alfa :=
    Soja            0.18
    Algodao         0.15
    Macauba         0.28
    Girassol        0.40
    Nabo_Forrageiro 0.35;

# Preços e receitas
param preco_biodiesel := 4500.0;          # valor da venda unitária do biodiesel 
param preco_glicerina := 1200.0;          # valor de venda unitária do coproduto (glicerina)
param rend_glicerina  := 0.10;            # rendimento da glicerina
param preco_carbono   := 50.0;            # créditos de carbono gerados pelo processo 

param preco_farelo :=
    Soja            800.0                # preço de venda do farelo de cada matéria-prima 
    Algodao         650.0
    Macauba         500.0
    Girassol        700.0
    Nabo_Forrageiro 600.0;

param rend_farelo :=
    Soja            0.75                 # rendimento do farela de cada matéria-prima (subproduto por ser usado em ração animal)
    Algodao         0.55
    Macauba         0.50
    Girassol        0.50
    Nabo_Forrageiro 0.45;

# Custos e capacidades gerais
param CC := 45.0;                             # Custo de Conversão
param Capacidade_Usina := 196362.0;

param Custo_Estoque_Semente :=
    Soja            15.0
    Algodao         12.0
    Macauba         10.0
    Girassol        14.0
    Nabo_Forrageiro 11.0;

param Custo_Fixo_Polo :=
    polo_norteMG    500000.0
    polo_semiarido  400000.0;

param Custo_Fixo_OGR :=
    rede_catadores_moc 150000.0                         # Ex: parcerias com cooperativas locais, catadores e redes de economia solidária
    rede_urbana        200000.0;                        # Ex: grandes centros comerciais e urbanos, como restaurantes e hotéis

# Limites operacionais por ano
param Cap_Descarga := 2024 140000.0 2025 160000.0;
param Cap_Armazenagem := 2024 80000.0 2025 90000.0;
param Cap_Frota_Caminhoes := 2024 140000.0 2025 160000.0;
param Cap_Carregamento := 2024 130000.0 2025 150000.0;

param C_OGR := rede_catadores_moc 110.0 rede_urbana 125.0;

param PC :=
    [polo_norteMG, *]   := Soja 140.0 Algodao 160.0 Macauba 120.0 Girassol 150.0 Nabo_Forrageiro 130.0
    [polo_semiarido, *] := Soja 155.0 Algodao 175.0 Macauba 135.0 Girassol 165.0 Nabo_Forrageiro 145.0;

param GTC := polo_norteMG 18.0 polo_semiarido 25.0;

# Demanda estocástica por cenário (S1, S2, S3)
param D :=
    [2024, *] := S1 88000.0  S2 98000.0  S3 112000.0
    [2025, *] := S1 103000.0 S2 115000.0 S3 132000.0;

# Custo do óleo externo estocástico por cenário
param v_cost :=
    [2024, *] := S1 420.0  S2 480.0  S3 550.0
    [2025, *] := S1 450.0  S2 510.0  S3 580.0;

# Produtividade agrícola estocástica (gama) por polo, matéria-prima, ano e cenário
param gama :=
    [polo_norteMG, Soja, 2024, *]            := S1 2.24  S2 2.80  S3 3.22
    [polo_norteMG, Soja, 2025, *]            := S1 2.48  S2 3.10  S3 3.56
    [polo_norteMG, Algodao, 2024, *]         := S1 1.76  S2 2.20  S3 2.53
    [polo_norteMG, Algodao, 2025, *]         := S1 1.92  S2 2.40  S3 2.76
    [polo_norteMG, Macauba, 2024, *]         := S1 2.80  S2 3.50  S3 4.02
    [polo_norteMG, Macauba, 2025, *]         := S1 3.04  S2 3.80  S3 4.37
    [polo_norteMG, Girassol, 2024, *]        := S1 1.20  S2 1.50  S3 1.72
    [polo_norteMG, Girassol, 2025, *]        := S1 1.36  S2 1.70  S3 1.95
    [polo_norteMG, Nabo_Forrageiro, 2024, *] := S1 1.44  S2 1.80  S3 2.07
    [polo_norteMG, Nabo_Forrageiro, 2025, *] := S1 1.60  S2 2.00  S3 2.30

    [polo_semiarido, Soja, 2024, *]            := S1 1.68  S2 2.10  S3 2.41
    [polo_semiarido, Soja, 2025, *]            := S1 1.84  S2 2.30  S3 2.64
    [polo_semiarido, Algodao, 2024, *]         := S1 1.36  S2 1.70  S3 1.95
    [polo_semiarido, Algodao, 2025, *]         := S1 1.52  S2 1.90  S3 2.18
    [polo_semiarido, Macauba, 2024, *]         := S1 2.32  S2 2.90  S3 3.33
    [polo_semiarido, Macauba, 2025, *]         := S1 2.48  S2 3.10  S3 3.56
    [polo_semiarido, Girassol, 2024, *]        := S1 0.96  S2 1.20  S3 1.38
    [polo_semiarido, Girassol, 2025, *]        := S1 1.04  S2 1.30  S3 1.49
    [polo_semiarido, Nabo_Forrageiro, 2024, *] := S1 1.12  S2 1.40  S3 1.61
    [polo_semiarido, Nabo_Forrageiro, 2025, *] := S1 1.20  S2 1.50  S3 1.72;

param AZ :=
    [polo_norteMG, *]   := 2024 12.0 2025 12.0
    [polo_semiarido, *] := 2024 15.0 2025 15.0;

param Z_barra :=
    [polo_norteMG, Soja, *]            := 2024 30000.0 2025 35000.0
    [polo_norteMG, Algodao, *]         := 2024 10000.0 2025 12000.0
    [polo_norteMG, Macauba, *]         := 2024 5000.0  2025 6000.0
    [polo_norteMG, Girassol, *]        := 2024 3000.0  2025 4000.0
    [polo_norteMG, Nabo_Forrageiro, *] := 2024 2000.0  2025 3000.0
    [polo_semiarido, Soja, *]          := 2024 20000.0 2025 22000.0
    [polo_semiarido, Algodao, *]       := 2024 8000.0  2025 9000.0
    [polo_semiarido, Macauba, *]       := 2024 6000.0  2025 7000.0
    [polo_semiarido, Girassol, *]      := 2024 3000.0  2025 3500.0
    [polo_semiarido, Nabo_Forrageiro, *]:= 2024 3000.0  2025 3500.0;

param TF := 2024 1800 2025 2200;            # meta de atendimento às famílias do Selo Social

param OfertaOGR :=
    [rede_catadores_moc, *] := 2024 90000.0 2025 100000.0      # limite de disponibilidade do óleo
    [rede_urbana, *]        := 2024 20000.0 2025 25000.0;

param CompraMax := 2024 15000.0 2025 20000.0;                  # compra máxima de óleo terceiro

end;
