    [polo_norteMG, Soja, 13, *]:= S1 1.60 S2 2.30 S3 2.90   [polo_norteMG, Soja, 14, *]:= S1 1.80 S2 2.50 S3 3.10
    [polo_norteMG, Soja, 15, *]:= S1 2.10 S2 2.90 S3 3.50   [polo_norteMG, Soja, 16, *]:= S1 2.70 S2 3.70 S3 4.50  # Pico Safra Ano 2
    [polo_norteMG, Soja, 17, *]:= S1 2.80 S2 3.80 S3 4.60  # Pico Safra Ano 2
    [polo_norteMG, Soja, 18, *]:= S1 2.30 S2 3.20 S3 3.90   [polo_norteMG, Soja, 19, *]:= S1 1.90 S2 2.60 S3 3.20
    [polo_norteMG, Soja, 20, *]:= S1 1.50 S2 2.10 S3 2.60   [polo_norteMG, Soja, 21, *]:= S1 1.30 S2 1.90 S3 2.40
    [polo_norteMG, Soja, 22, *]:= S1 1.40 S2 2.00 S3 2.50   [polo_norteMG, Soja, 23, *]:= S1 1.50 S2 2.20 S3 2.70
