    [polo_norteMG, Soja, 6, *] := S1 2.20 S2 3.10 S3 3.80
    [polo_norteMG, Soja, 7, *] := S1 1.80 S2 2.50 S3 3.10    [polo_norteMG, Soja, 8, *] := S1 1.40 S2 2.00 S3 2.50
